  "design_notes": "Randomized, multicenter, double-blind, placebo-controlled, parallel-group phase 2 trial",
  "population": {
    "condition": "type 2 diabetes and overweight or obesity",
    "key_inclusion_criteria": [
      "Aged 18–64 years",
      "Type 2 diabetes diagnosed ≥180 days before screening",
