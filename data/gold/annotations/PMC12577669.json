  "design_notes": "Randomized, phase IIa, open label, parallel-group, single-center trial",
  "population": {
    "condition": "multiple system atrophy (MSA)",
    "key_inclusion_criteria": [
      "Eligible men and women were aged 30 to 80 years",
      "had a diagnosis of possible or probable MSA of the parkinsonian (MSA-P) or cerebellar subtype (MSA-C) according to the Gilman Criteria.",
      "Participants were less than 5 years from the time of documented MSA diagnosis, or from the time of previously documented parkinsonian/ataxic neurological condition, which was later re-diagnosed as MSA.",
      "They were able to walk at least 10 meters (with or without assistance)",
      "had an anticipated survival of at least 3 years in the opinion of the investigator."
    ],
