{
  "pmcid": "PMC11417641",
  "trial_registration": "NCT04019197",
  "design_notes": "Randomised, double-blind, placebo-controlled phase IIb clinical trial conducted at a single US site. Participants were randomised 1:1 to receive 32 weeks of once-weekly subcutaneous semaglutide or matching placebo. The intervention included an 8-week dose titration phase and 24 weeks at 1.0 mg. Analyses were performed using intention-to-treat principles.",
  "population": {
    "condition": "HIV-associated lipohypertrophy",
    "key_inclusion_criteria": [
      "≥18 years old with documented HIV-1 infection",
      "cumulative ART duration ≥1 year",
      "receiving a stable ART regimen for ≥12 weeks",
      "HIV-1 RNA <400 copies/mL for ≥6 months prior to entry",
      "subjective observation of increased abdominal girth occurring after ART initiation",
      "waist circumference (WC) and waist-to-hip ratio (WHR) of >95 cm and >0.94 cm, respectively, for men, and >94 cm and >0.88 cm, respectively, for women",
      "body mass index (BMI) of ≥25 kg/m2",
      "Known history of diabetes was exclusionary"
    ],
    "mean_age": null,
    "percent_female": 39.8,
    "evidence": []
  },
  "arms": [
    {
      "name": "Semaglutide",
      "role": "experimental",
      "drug": "semaglutide",
      "dose": "0.25 mg weekly for 4 weeks, followed by 0.5 mg weekly for another 4 weeks, then 1.0 mg weekly for 24 weeks",
      "route": "subcutaneous",
      "is_fixed_combination": false,
      "n_randomized": 54,
      "n_analyzed": 54,
      "evidence": []
    },
