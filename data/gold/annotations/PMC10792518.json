      "role": "experimental",
      "drug": "semaglutide",
      "dose": "2·4 mg once weekly",
      "route": "subcutaneous",
      "is_fixed_combination": false,
      "n_randomized": 47,
      "n_analyzed": 47,
      "evidence": []
    },
    {
