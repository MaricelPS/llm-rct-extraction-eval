  "pmcid": "PMC13538791",
  "trial_registration": "NCT05514535",
  "design_notes": "SUSTAIN OPTIMIZE was a 40-week, phase 3b, open-label, parallel-group, randomised trial performed at 113 outpatient clinical trial sites in 9 countries across North America, Europe, and Africa. Participants were randomised in a 1:1 ratio. The study consisted of a 2-week screening period followed by a 40-week intervention period and a subsequent 5-week follow-up period.",
  "population": {
    "condition": "type 2 diabetes (T2D) and overweight",
    "key_inclusion_criteria": [
      "aged ≥ 18 years",
      "having T2D ≥ 180 days before screening",
      "HbA1c level of 7%–10% (53–86 mmol/mol) (both inclusive)",
      "body mass index (BMI) ≥ 25 kg/m2",
      "treatment with a once-daily basal insulin ≤ 40 units/day for at least 90 days before screening, and on a stable dose of metformin (≥ 1500 mg or maximum tolerated or effective dose) with or without sodium-glucose cotransporter-2 inhibitors (SGLT2is) for at least 90 days before screening"
    ],
    "mean_age": 61.1,
    "percent_female": 44.2,
    "evidence": []
  },
