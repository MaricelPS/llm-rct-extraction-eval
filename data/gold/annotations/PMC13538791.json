      "role": "experimental",
      "drug": "semaglutide 2.0 mg as add-on to dose-reduced insulin glargine",
      "dose": "semaglutide once weekly, escalated from 0.25 mg to 0.5, 1.0, and 2.0 mg/week; insulin glargine dose reduced by 10 U every 4 weeks according to the fixed-dose de-escalation regimen",
      "route": "subcutaneous",
      "is_fixed_combination": false,
      "n_randomized": 288,
      "n_analyzed": 288,
      "evidence": []
    },
    {
