# NCBI E-utilities (email is required by NCBI usage policy)
PX_NCBI_EMAIL=
# Optional: raises rate limit from 3 to 10 requests/second
PX_NCBI_API_KEY=
# Anthropic API key, required only for LLM extraction
PX_ANTHROPIC_API_KEY=
# Optional overrides
# PX_EXTRACTION_MODEL=claude-sonnet-5
# PX_EXTRACTION_MAX_TOKENS=8192
